# Copy these names into GitHub Actions secrets or your host environment.
# Do not put real tokens in git.

# Todoist REST API token (Settings → Integrations → Developer).
TODOIST_API_TOKEN=

# GitHub token used by the `gh` CLI.
# GitHub Actions: store as repository secret GH_PAT, mapped to GH_TOKEN in the workflow.
# cron / Hermes / other agents: export GH_TOKEN, or `gh auth login` on the host.
#
# Default GITHUB_TOKEN in Actions cannot read other repos or Projects.
#
# Classic PAT scopes:
#   repo          (or public_repo if every synced repo is public)
#   read:project
#   read:org      (needed for some user/org Projects v2 boards)
#
# Fine-grained PAT:
#   Issues: Read on every synced repository
#   Projects: Read
GH_TOKEN=

# Path to your filled copy of schema.example.json.
# Used by cron.example.sh and the Python CLI (`--config` or this env var).
# GitHub Actions does not use this path: paste the JSON body into
# repository *variable* PROJECTS_JSON (Settings → Secrets and variables
# → Actions → Variables). Names cannot start with GITHUB_. Secrets are
# write-only; a variable can be opened and edited. Do not commit the filled JSON.
GITHUB_PROJECTS_CONFIG=
